# Public site URL. No trailing slash. Used in canonical URLs, sitemap entries, OG images.
# Set this to your real domain in production (e.g. https://www.immonationgmbh.de).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tippgeber intake. Use a verified Resend sender domain in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Immonation <noreply@example.com>
REFERRAL_TO_EMAIL=info@example.com

# Server-only onOffice enterprise API credentials. Never expose these with a
# NEXT_PUBLIC_ prefix. The stable endpoint is the official production API.
ONOFFICE_API_TOKEN=
ONOFFICE_API_SECRET=
ONOFFICE_API_URL=https://api.onoffice.de/api/stable/api.php
